    "question",
    "answer",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
