{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "registry_draft",
  "type": "object",
  "required": [
    "ontology",
    "corpus"
  ],
  "properties": {
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "definition",
              "examples",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "claim_types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "definition",
              "examples",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "relation_types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "definition",
              "examples",
              "evidence",
              "direction",
              "direction_semantics"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "directed",
                  "symmetric"
                ]
              },
              "direction_semantics": {
                "type": "string",
                "minLength": 1
              },
              "allowed_src": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "allowed_dst": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "topics": {
          "type": "array",
