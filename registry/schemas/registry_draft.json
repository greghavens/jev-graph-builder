              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "doc_types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "definition",
              "examples",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "chunk_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "definition",
              "examples",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "policies": {
      "type": "object"
    },
    "extraction_notes": {
      "type": "string"
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "corpus": {
      "type": "object",
      "required": [
        "scope",
        "languages"
      ],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
