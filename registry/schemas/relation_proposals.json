{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "relation_proposals",
  "type": "object",
  "required": [
    "relations"
  ],
  "properties": {
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "definition",
          "examples",
          "evidence",
          "direction",
          "direction_semantics"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": [
                    "source",
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          "parent": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "directed",
              "symmetric"
            ]
          },
          "direction_semantics": {
            "type": "string",
            "minLength": 1
          },
          "allowed_src": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "allowed_dst": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
